# OpenWebUI configuration
WEBUI_SECRET_KEY=your-secret-key-change-this

# Neo4j (for mcp-server and make seed-db)
# Defaults work for local dev.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Semantic Scholar API rate limiting (mcp-server)
# Min seconds between calls. Default 3 (free tier ~100 req/5min). Increase if still rate limited.
# SEMANTIC_SCHOLAR_DELAY_SECONDS=3
