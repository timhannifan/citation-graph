# OpenWebUI configuration
WEBUI_SECRET_KEY=your-secret-key-change-this

# Neo4j (for mcp-server and make seed-db)
# Defaults work for local dev.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Semantic Scholar API rate limiting
SEMANTIC_SCHOLAR_API_KEY=your-secret-key
SEMANTIC_SCHOLAR_DELAY_SECONDS=2